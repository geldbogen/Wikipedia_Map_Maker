        <Folder id="12">
            <name>wikivoyage</name>
            <Placemark id="845">
                <name>Denver Union Station </name>
                <description>
                category  : Get in_By train &lt;br&gt;
                address  :  1701 Wynkoop St  &lt;br&gt;
                url  : http://unionstationindenver.com  &lt;br&gt;
                description  :  An extensive renovation has restored Union Station to its former glory. It now boasts an on-premise hotel, several restaurants and bars as well as plenty of seating for the tired traveller. Denver Union Station is often cited as the &quot;poster boy&quot; for the revival of train stations, train travel in general and the adjacent neighborhoods that can be observed in several North American and European cities. Union Station is also known for its iconic &quot;travel by train&quot; sign first put there in the 1950s when arrivals at Stapleton Airport started to outstrip traffic at Union Station. In addition to Amtrak trains, [http://www.rtd-denver.com/ '''RTD'''] commuter and light rail services also call at Union Station, providing easy access to many places in the Denver area if you arrive by train. &lt;br&gt;
                </description>
                <styleUrl>#133</styleUrl>
                <Point id="844">
                    <coordinates>-105.0,39.7531,0.0</coordinates>
                </Point>
            </Placemark>
            <Placemark id="847">
                <name>Boulder</name>
                <description>
                category  : Get in_By highway &lt;br&gt;
                address  :  &lt;br&gt;
                url  :  &lt;br&gt;
                description  : '''U.S. Highway 36''' connects to the northwestern suburbs and on to Boulder. &lt;br&gt;
                </description>
                <styleUrl>#37</styleUrl>
                <Point id="846">
                    <coordinates>-105.011396,39.7585496,0.0</coordinates>
                </Point>
            </Placemark>
            <Placemark id="849">
                <name>El Paso Los Angeles Limousine Express </name>
                <description>
                category  : Get in_By bus &lt;br&gt;
                address  : (bus station) 2215 E California St  &lt;br&gt;
                url  : http://www.eplalimo.com  &lt;br&gt;
                description  : Travels along I-25 between Greeley, Denver, Colorado Springs, Pueblo, Santa Fe, Albuquerque, Deming, Las Cruces and El Paso. The depot in Greeley is at 2410 8th Ave. &lt;br&gt;
                </description>
                <styleUrl>#141</styleUrl>
                <Point id="848">
                    <coordinates>-104.98493,39.7513,0.0</coordinates>
                </Point>
            </Placemark>
            <Placemark id="851">
                <name>Los Paisanos </name>
                <description>
                category  : Get in_By bus &lt;br&gt;
                address  : (bus station) 2147 Broadway  &lt;br&gt;
                url  : http://lospaisanosautobuses.com/  &lt;br&gt;
                description  : Travels between Caldwell (near Boise) and El Paso via Salt Lake City, Greely, Denver and Roswell. &lt;br&gt;
                </description>
                <styleUrl>#141</styleUrl>
                <Point id="850">
                    <coordinates>-104.98764,39.7517,0.0</coordinates>
                </Point>
            </Placemark>
            <Placemark id="853">
                <name>Center for Colorado Women's History </name>
                <description>
                category  : See_Museums and architecture &lt;br&gt;
                address  : 1310 Bannock St  &lt;br&gt;
                url  : https://www.historycolorado.org/center-colorado-womens-history  &lt;br&gt;
                description  : One of Denver's great historic homes, built in 1883 by ''Rocky Mountain News'' publisher Williams Byers and elegantly furnished with original turn of the (20th) century pieces. Tour the house or catch featured exhibitions in the gallery. &lt;br&gt;
                </description>
                <styleUrl>#121</styleUrl>
                <Point id="852">
                    <coordinates>-104.98982,39.73713,0.0</coordinates>
                </Point>
            </Placemark>
            <Placemark id="855">
                <name>Chamberlin Observatory </name>
                <description>
                category  : See_Museums and architecture &lt;br&gt;
                address  : 2930 E Warren Ave  &lt;br&gt;
                url  : http://mysite.du.edu/~rstencel/Chamberlin/  &lt;br&gt;
                description  : Built in 1890, this working observatory is a historic landmark and a pride of the University of Denver. Star Parties and other events are open to the public. &lt;br&gt;
                </description>
                <styleUrl>#121</styleUrl>
                <Point id="854">
                    <coordinates>-104.95297,39.67605,0.0</coordinates>
                </Point>
            </Placemark>
            <Placemark id="857">
                <name>Children's Museum of Denver </name>
                <description>
                category  : See_Museums and architecture &lt;br&gt;
                address  : 2121 Children's Museum Dr  &lt;br&gt;
                url  : http://www.mychildsmuseum.org/  &lt;br&gt;
                description  : This educational museum takes a fun, hands-on approach to learning. Note: No adults are allowed in the Museum without a child, and no children without an adult. &lt;br&gt;
                </description>
                <styleUrl>#121</styleUrl>
                <Point id="856">
                    <coordinates>-105.017,39.749,0.0</coordinates>
                </Point>
            </Placemark>
            <Placemark id="859">
                <name>Colorado State Capitol </name>
                <description>
                category  : See_Museums and architecture &lt;br&gt;
                address  : 200 E Colfax Ave  &lt;br&gt;
                url  : https://capitol.colorado.gov/  &lt;br&gt;
                description  : A gorgeous domed building at the southern edge of Downtown. Tours are available, though the big attraction for tourists is standing above the words &quot;One Mile Above Sea Level&quot; engraved into one of the steps out front. Free tours start at the visitor information desk every hour M-F 10AM-3PM. &lt;br&gt;
                </description>
                <styleUrl>#121</styleUrl>
