                category  : Do_Live music &lt;br&gt;
                address  : 2022 E. Colfax Ave  &lt;br&gt;
                url  : http://lionslairco.com/  &lt;br&gt;
                description  : Famous, or should we say ''in''famous, dive bar in Colfax that's been a gathering place for Denver-area punk, hardcore, and thrash fans since the 80s. The drinks are cheap, the lights are dim, and the ambience is grungy - and that's meant in a good way. &lt;br&gt;
                </description>
                <styleUrl>#149</styleUrl>
                <Point id="930">
                    <coordinates>-104.96244,39.73983,0.0</coordinates>
                </Point>
            </Placemark>
            <Placemark id="933">
