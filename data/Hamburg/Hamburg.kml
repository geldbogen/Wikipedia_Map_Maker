                category  : See_Museums &lt;br&gt;
                address  :   &lt;br&gt;
                url  : http://www.speicherstadtmuseum.de/#  &lt;br&gt;
                description  : Branch of Museum of Labour in docklands warehouse. History of the district and tea and coffee trade. &lt;br&gt;
                </description>
                <styleUrl>#122</styleUrl>
                <Point id="3759">
                    <coordinates>9.98758,53.54311,0.0</coordinates>
                </Point>
            </Placemark>
