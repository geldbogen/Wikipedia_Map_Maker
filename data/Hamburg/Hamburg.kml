            <Placemark id="4204">
                <name>Bremen</name>
                <description>
                category  : Go next &lt;br&gt;
                address  :  &lt;br&gt;
                url  :  &lt;br&gt;
                description  : '''Bremen''' — A hanseatic city 95 km away, famous for the ''Bremer Stadtmusikanten'' (Town Musicians of Bremen). &lt;br&gt;
                </description>
                <styleUrl>#170</styleUrl>
                <Point id="4203">
                    <coordinates>8.8071646,53.0758196,0.0</coordinates>
                </Point>
