                <name>Altona City Hall </name>
                <description>
                category  : See_Altona &lt;br&gt;
                address  :   &lt;br&gt;
                url  :   &lt;br&gt;
                description  : Built in 1898, when Altona still was a separate city. It's an impressive building with influcences of Italian renaissance. &lt;br&gt;
                </description>
                <styleUrl>#110</styleUrl>
                <Point id="3909">
                    <coordinates>9.9354,53.547,0.0</coordinates>
