                category  : Eat &lt;br&gt;
                address  : 52 Irving Pl  &lt;br&gt;
                url  : http://casamononyc.com/  &lt;br&gt;
                description  : A delightful Spanish wine bar and restaurant by Mario Batali. The food is smashing. &lt;br&gt;
                </description>
                <styleUrl>#78</styleUrl>
                <Point id="1703">
                    <coordinates>-73.98715,40.73592,0.0</coordinates>
                </Point>
            </Placemark>
