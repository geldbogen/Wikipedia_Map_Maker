                <description>
                category  : Eat &lt;br&gt;
                address  : 81 Lexington Ave  &lt;br&gt;
                url  :   &lt;br&gt;
                description  : Excellent South Indian food at good prices. This is a vegetarian kosher restaurant and a branch of one in [[Chennai]] (Madras), India. Expect to wait a half hour or so on weekends. &lt;br&gt;
                </description>
                <styleUrl>#78</styleUrl>
                <Point id="1711">
                    <coordinates>-73.98312,40.74144,0.0</coordinates>
                </Point>
            </Placemark>
