                <name>Breach Candy </name>
                <description>
                category  : Buy_Markets &lt;br&gt;
                address  : Bhulabhai Desai Rd  &lt;br&gt;
                url  :   &lt;br&gt;
                description  : Home to Premsons and Amarsons department stores. &lt;br&gt;
                </description>
