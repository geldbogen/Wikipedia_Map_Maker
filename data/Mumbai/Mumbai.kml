                <description>
                category  : Buy &lt;br&gt;
                address  : 1500 Broadway  &lt;br&gt;
                url  : http://www.sephora.com  &lt;br&gt;
                description  : One-stop shopping for cosmetics. &lt;br&gt;
                </description>
                <styleUrl>#166</styleUrl>
                <Point id="1801">
                    <coordinates>-73.98567,40.75677,0.0</coordinates>
                </Point>
            </Placemark>
