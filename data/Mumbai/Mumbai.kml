            <Placemark id="662">
                <name>Utsav Chowk </name>
                <description>
                category  : See &lt;br&gt;
                address  : Kharghar  &lt;br&gt;
                url  :   &lt;br&gt;
                description  : One of the most famous landmarks in the area and it stands out for its eye catching architecture which is a humble reflection of the Roman and Greek architecture. &lt;br&gt;
                </description>
                <styleUrl>#110</styleUrl>
                <Point id="661">
                    <coordinates>73.0617,19.0362,0.0</coordinates>
