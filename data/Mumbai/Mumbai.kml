            <Placemark id="2250">
                <name>Absolute Bagels </name>
                <description>
                category  : Eat_Budget &lt;br&gt;
                address  : 2788 Broadway  &lt;br&gt;
                url  : http://www.absolutebagels.com/  &lt;br&gt;
                description  : A true New York bagel shop with a fanatical following, often ranking among the very best bagels in the city. There's usually a long line out the door, but it tends to move quickly. Lots of spread and sandwich options are available. &lt;br&gt;
                </description>
                <styleUrl>#82</styleUrl>
                <Point id="2249">
                    <coordinates>-73.9674,40.80245,0.0</coordinates>
                </Point>
            </Placemark>
            <Placemark id="2252">
