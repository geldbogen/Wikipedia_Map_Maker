                <description>
                category  : Buy &lt;br&gt;
                address  : 1540 Broadway  &lt;br&gt;
                url  : http://www.shopdisney.com  &lt;br&gt;
                description  : A 2-level store for Disney merchandise. &lt;br&gt;
                </description>
                <styleUrl>#166</styleUrl>
                <Point id="1809">
                    <coordinates>-73.984965,40.758854,0.0</coordinates>
                </Point>
            </Placemark>
