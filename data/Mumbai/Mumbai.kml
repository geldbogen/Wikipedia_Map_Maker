            <Placemark id="2054">
                <name>Pat Hoffman Friedman Playground </name>
                <description>
                category  : Do_Playgrounds &lt;br&gt;
                address  : 5th Avenue and 79th Street  &lt;br&gt;
                url  :   &lt;br&gt;
                description  : A small toddler playground with some beautifully fashioned gates adorned with sculptures of animals. In front of the gates stands Paul Manship's ''Group of Bears'' sculpture. &lt;br&gt;
                </description>
                <styleUrl>#150</styleUrl>
                <Point id="2053">
                    <coordinates>-73.96385,40.77761,0.0</coordinates>
                </Point>
