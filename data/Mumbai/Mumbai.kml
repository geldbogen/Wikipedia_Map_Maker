                <name>Kramer's Reality Tour </name>
                <description>
                category  : Do &lt;br&gt;
                address  : 358 W 44th St  &lt;br&gt;
                url  : http://www.kennykramer.com  &lt;br&gt;
                description  : For ''[[Seinfeld Tour &lt;br&gt;
                </description>
