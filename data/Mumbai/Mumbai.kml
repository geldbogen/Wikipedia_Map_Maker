                <name>Shake Shack </name>
                <description>
                category  : Eat &lt;br&gt;
                address  : Madison Square Park  &lt;br&gt;
                url  : http://shakeshacknyc.com  &lt;br&gt;
                description  : Awesome roadside food stand in Madison Square Park serving hot dogs, burgers, frozen custard, beer, and wine. Though reputed for their burgers, they also serve what is widely regarded as the best Chicago-style hot dog in New York. &lt;br&gt;
                </description>
                <styleUrl>#78</styleUrl>
                <Point id="1713">
