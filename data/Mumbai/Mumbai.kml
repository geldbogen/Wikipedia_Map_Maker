                <name>Billy Johnson Playground </name>
                <description>
                category  : Do_Playgrounds &lt;br&gt;
                address  : 5th Avenue and 67th Street  &lt;br&gt;
                url  :   &lt;br&gt;
                description  : A rustic-themed playground, with a stone bridge, a granite slide, a gazebo, a water feature, and playground equipment constructed of white cedar. &lt;br&gt;
                </description>
