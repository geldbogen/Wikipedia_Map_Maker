                <name>Grove Court </name>
                <description>
                category  : See &lt;br&gt;
                address  : Grove St  &lt;br&gt;
                url  :   &lt;br&gt;
                description  : The setting for O'Henry's famous short story, ''The Last Leaf''. &lt;br&gt;
                </description>
                <styleUrl>#110</styleUrl>
                <Point id="1369">
                    <coordinates>-74.0058,40.73214,0.0</coordinates>
                </Point>
