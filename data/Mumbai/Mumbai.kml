                <name>Nicholas Roerich Museum </name>
                <description>
                category  : See_Museums &lt;br&gt;
                address  : 319 W. 107th St  &lt;br&gt;
                url  : http://www.roerich.org/  &lt;br&gt;
                description  :  &lt;br&gt;
                </description>
                <styleUrl>#122</styleUrl>
