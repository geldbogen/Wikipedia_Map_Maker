                <name>Lincoln Square 13 Cinema </name>
                <description>
                category  : Do_Cinemas &lt;br&gt;
                address  : 1998 Broadway  &lt;br&gt;
                url  : http://www.fandango.com/amcloewslincolnsquare13withimax_aabqi/theaterpage?wssac &lt;br&gt;
                description  : A multiplex two blocks from Lincoln Center, showing major, first-run films on 13 screens. It also contains an IMAX cinema showing mainstream feature films. &lt;br&gt;
                </description>
                <styleUrl>#158</styleUrl>
