            </Placemark>
            <Placemark id="2062">
                <name>SummerStage </name>
                <description>
                category  : Do_Events &lt;br&gt;
                address  : Rumsey Playfield  &lt;br&gt;
                url  : http://www.summerstage.org/  &lt;br&gt;
                description  : A popular free concert series held in the summer. &lt;br&gt;
                </description>
                <styleUrl>#150</styleUrl>
