                <description>
                category  : Filming locations and places featured on the show_New York City_Manhattan &lt;br&gt;
                address  : 75 Varick St., SoHo  &lt;br&gt;
                url  :   &lt;br&gt;
                description  : Where George offers to take his unemployment officer's unattractive daughter on a date to avoid getting his benefits cut off, only to get dumped at the end. (&quot;You've got no job, you've got no prospects. You're like Biff Loman.&quot;) &lt;br&gt;
                </description>
                <styleUrl>#38</styleUrl>
                <Point id="917">
                    <coordinates>-74.006391,40.723306,0.0</coordinates>
                </Point>
