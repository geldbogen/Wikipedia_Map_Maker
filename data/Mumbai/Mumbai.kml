                <name>Heera Panna Shopping Centre </name>
                <description>
                category  : Buy_Markets &lt;br&gt;
                address  : Tardeo Rd, Malviya Nagar  &lt;br&gt;
                url  :   &lt;br&gt;
                description  : It's a popular shopping destination for locals and shops usually deal in imported goods and electronics. &lt;br&gt;
                </description>
