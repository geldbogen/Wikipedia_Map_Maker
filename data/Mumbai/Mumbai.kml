            <Placemark id="660">
                <name>Pandavkada Falls </name>
                <description>
                category  : See &lt;br&gt;
                address  : Sector-8, Kharghar  &lt;br&gt;
                url  :   &lt;br&gt;
                description  : Monsoon tourist attraction for people from far and wide. Authorities are strict in not allowing people to visit this place in monsoon on account of accidental deaths in the waterfall. &lt;br&gt;
