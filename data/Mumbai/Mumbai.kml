                <description>
                category  : Eat_Mid-range &lt;br&gt;
                address  : Mahalaxmi Race Course  &lt;br&gt;
                url  :   &lt;br&gt;
                description  : Continental and Indian food restaurant. It's expensive, but worth it for the ambiance, service, and food. &lt;br&gt;
                </description>
