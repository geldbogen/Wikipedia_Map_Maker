                <name>Manhattan/East Village|East Village</name>
                <description>
                category  : Go next &lt;br&gt;
                address  :  &lt;br&gt;
                url  :  &lt;br&gt;
                description  : the '''Manhattan/East Village|East Village''', which is to a large extent a northern extension of the Lower East Side; &lt;br&gt;
                </description>
                <styleUrl>#170</styleUrl>
                <Point id="1361">
