            <Placemark id="1906">
                <name>Paley Park </name>
                <description>
                category  : See_Parks and recreation &lt;br&gt;
                address  : 53rd St  &lt;br&gt;
                url  :   &lt;br&gt;
                description  : Another pocket park which is celebrated among landscape architects and urban designers, Paley is a great place to relax, with plenty of chairs below a canopy of trees and a waterfall spanning the entire back wall of the park. &lt;br&gt;
                </description>
                <styleUrl>#114</styleUrl>
                <Point id="1905">
                    <coordinates>-73.9751,40.7603,0.0</coordinates>
