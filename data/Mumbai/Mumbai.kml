                <description>
                category  : Eat &lt;br&gt;
                address  : 159 Lexington Ave  &lt;br&gt;
                url  : http://www.penelopenyc.com/  &lt;br&gt;
                description  : Cafe/restaurant/bakery with a cozy, inviting atmosphere. Homestyle food and casual but friendly service. Inexpensive. Wine and beer served. Long lines for weekend brunch. &lt;br&gt;
                </description>
                <styleUrl>#78</styleUrl>
                <Point id="1709">
                    <coordinates>-73.98143,40.74367,0.0</coordinates>
                </Point>
