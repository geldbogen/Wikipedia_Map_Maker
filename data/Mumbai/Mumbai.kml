                <name>Byculla Restaurant and Bakery </name>
                <description>
                category  : Eat &lt;br&gt;
                address  : Byculla W  &lt;br&gt;
                url  :   &lt;br&gt;
                description  : A typical Iranian restaurant that has been in business for just under a century. &lt;br&gt;
                </description>
                <styleUrl>#78</styleUrl>
                <Point id="2819">
                    <coordinates>72.83397,18.97508,0.0</coordinates>
                </Point>
            </Placemark>
