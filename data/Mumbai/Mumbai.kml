                <name>New York University </name>
                <description>
                category  : See &lt;br&gt;
                address  :   &lt;br&gt;
                url  : http://nyu.edu  &lt;br&gt;
                description  : The main campus for NYU is found in Greenwich Village, centered around Washington Square Park. &lt;br&gt;
                </description>
