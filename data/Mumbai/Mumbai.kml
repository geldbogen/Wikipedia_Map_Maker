                <description>
                category  : Drink &lt;br&gt;
                address  : 2A/1, Dr Annie Besant Rd, Atria mall, Worli  &lt;br&gt;
                url  :   &lt;br&gt;
                description  : DJ Aqeel's nightclub.  &lt;br&gt;
                </description>
                <styleUrl>#58</styleUrl>
                <Point id="2825">
                    <coordinates>72.8145,18.99105,0.0</coordinates>
