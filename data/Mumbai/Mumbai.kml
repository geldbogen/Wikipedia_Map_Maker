                <Point id="2197">
                    <coordinates>-73.9772,40.7859,0.0</coordinates>
                </Point>
            </Placemark>
            <Placemark id="2200">
                <name>Cathedral Church of St. John the Divine </name>
                <description>
                category  : See_Churches and cathedrals &lt;br&gt;
                address  : 1047 Amsterdam Ave  &lt;br&gt;
                url  : http://www.stjohndivine.org/  &lt;br&gt;
                description  : The world's largest neo-[[Gothic]] cathedral, the place has been a work in progress for over a century! There are also resident peacocks on campus, and many songbirds stop by during their seasonal migrations. &lt;br&gt;
                </description>
                <styleUrl>#130</styleUrl>
