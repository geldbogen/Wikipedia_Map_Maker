                <name>Safari Playground </name>
                <description>
                category  : Do_Playgrounds &lt;br&gt;
                address  : Central Park West at 91st Street  &lt;br&gt;
                url  :   &lt;br&gt;
                description  : A jungle themed playground with hippopotamus statues, a &quot;canoe&quot; play structure, and treehouses. &lt;br&gt;
                </description>
                <styleUrl>#150</styleUrl>
                <Point id="2055">
                    <coordinates>-73.96668,40.78836,0.0</coordinates>
                </Point>
            </Placemark>
            <Placemark id="2058">
                <name>Wild West Playground </name>
                <description>
                category  : Do_Playgrounds &lt;br&gt;
                address  : Central Park West at 93rd Street  &lt;br&gt;
                url  :   &lt;br&gt;
                description  : A Western-themed playground with a wooded fortress-like setting, canals, sandboxes, and water sprays. &lt;br&gt;
                </description>
                <styleUrl>#150</styleUrl>
