            </Placemark>
            <Placemark id="2752">
                <name>Mangaldas Market </name>
                <description>
                category  : Buy_Markets &lt;br&gt;
                address  : Janjikar St  &lt;br&gt;
                url  :   &lt;br&gt;
                description  :  for silk and cloth &lt;br&gt;
                </description>
