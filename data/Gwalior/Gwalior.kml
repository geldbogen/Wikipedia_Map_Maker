            <name>wikivoyage</name>
            <Placemark id="245">
                <name>Gwalior Airport </name>
                <description>
                category  : Get in_By plane &lt;br&gt;
                address  :   &lt;br&gt;
                url  :   &lt;br&gt;
                description  : One of four airports in the region. It is also the site of an Indian Air Force Base. Gwalior airport has some scheduled domestic services from New Delhi, Mumbai, Ahmadabad, Bangalore, Kolkata, Hyderabad, Jammu and Indore on daily basis. &lt;br&gt;
                </description>
                <styleUrl>#137</styleUrl>
                <Point id="244">
                    <coordinates>78.227778,26.293333,0.0</coordinates>
                </Point>
            </Placemark>
