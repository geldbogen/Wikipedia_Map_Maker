            <Placemark id="509">
                <name>The Trident Jaipur </name>
                <description>
                category  : Sleep_Splurge &lt;br&gt;
                address  : Amber Fort Rd  &lt;br&gt;
                url  : http://www.tridenthotels.com/jaipur/index.asp  &lt;br&gt;
                description  : Surprisingly intimate low-rise hotel built like a glittering white Mughal palace, renovated and well maintained. Small pool. It's worth it to pay extra for a lake view room. &lt;br&gt;
                </description>
                <styleUrl>#105</styleUrl>
