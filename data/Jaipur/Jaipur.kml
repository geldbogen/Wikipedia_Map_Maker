                category  : Sleep_Splurge &lt;br&gt;
                address  :   &lt;br&gt;
                url  : http://www.tajhotels.com/luxury/grand-palaces-and-iconic-hotels/rambagh-palace-jaipur/overview.html  &lt;br&gt;
                description  : A former palace and an excellent place to stay. &lt;br&gt;
                </description>
                <styleUrl>#105</styleUrl>
                <Point id="506">
