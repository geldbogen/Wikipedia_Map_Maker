            <Placemark id="2302">
                <name>Fenerbahçe Marina </name>
                <description>
                category  : Eat &lt;br&gt;
                address  :   &lt;br&gt;
                url  :   &lt;br&gt;
                description  : Fenerbahçe translates to Lighthouse Garden, in reference to a historic lighthouse built in 1562. The neighborhood gives its name to the Fenerbahçe Sports Club. The marina and the trailing street are home to some solid restaurant choices (''Midpoint'', Happy ''Moon's'' etc.). &lt;br&gt;
                </description>
                <styleUrl>#78</styleUrl>
                <Point id="2301">
                    <coordinates>29.03861,40.97109,0.0</coordinates>
