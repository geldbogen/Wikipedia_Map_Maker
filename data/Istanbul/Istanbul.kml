                category  : Eat &lt;br&gt;
                address  :   &lt;br&gt;
                url  :   &lt;br&gt;
                description  : Multiple choices ranging from kebabs (''Sahra'') to pastry (''Görgülü'') to sushis (''Konoha''). &lt;br&gt;
                </description>
                <styleUrl>#78</styleUrl>
                <Point id="2299">
                    <coordinates>29.03819,40.99923,0.0</coordinates>
